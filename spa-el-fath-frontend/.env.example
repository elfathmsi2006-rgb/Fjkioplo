# Frontend API endpoint. Must point to the running SPA El Fath backend.
VITE_API_URL=http://localhost:3000

# Set to true ONLY for an isolated local UI preview. This bypasses sign-in.
# Leave false or unset for normal use with backend authentication.
VITE_DEMO_MODE=false

# Keep false until the backend manuals table and persistent storage are configured
VITE_MACHINE_MANUALS_ENABLED=false
